start: statement*

?statement: function_def
          | local_decl
          | if_stmt
          | for_stmt
          | while_stmt
          | return_stmt
          | assignment
          | expr_stmt

function_def: "function" function_name "(" [param_list] ")" block "end"
            | "function" function_name ":" NAME "(" [param_list] ")" block "end"

function_name: NAME ("." NAME)*

param_list: NAME ("," NAME)*

local_decl: "local" NAME ("," NAME)* ["=" expr_list]

if_stmt: "if" expr "then" block elif_parts else_part "end"
       | "if" "(" expr ")" statement ["else" statement+]

elif_parts: ("elseif" expr "then" block)*

else_part: ["else" block]

for_stmt: "for" NAME "=" expr "," expr ["," expr] "do" block "end"
        | "for" NAME ("," NAME)* "in" expr "do" block "end"

while_stmt: "while" expr "do" block "end"
          | "while" "(" expr ")" statement

return_stmt: "return" [expr_list]

block: statement*

?expr_stmt: expr

assignment: assignable ("," assignable)* "=" expr_list
          | assignable "+=" expr
          | assignable "-=" expr
          | assignable "*=" expr
          | assignable "/=" expr
          | assignable "%=" expr

assignable: NAME table_suffix*

expr_list: expr ("," expr)*

?expr: or_expr

?or_expr: and_expr ("or" and_expr)*

?and_expr: not_expr ("and" not_expr)*

?not_expr: "not" not_expr
         | comparison

?comparison: concat (COMP_OP concat)*

COMP_OP: "==" | "~=" | "<=" | ">=" | "<" | ">"

?concat: add_expr (".." add_expr)*

?add_expr: mult_expr (ADD_OP mult_expr)*

ADD_OP: "+" | "-"

?mult_expr: unary (MULT_OP unary)*

MULT_OP: "*" | "/" | "%" | "\\"

?unary: "-" unary
      | "#" unary
      | atom

?atom: primary suffix*

?suffix: table_suffix
       | function_call

table_suffix: "." NAME
            | "[" expr "]"

function_call: "(" [expr_list] ")"
             | ":" NAME "(" [expr_list] ")"

primary: NUMBER
       | STRING
       | BOOLEAN
       | NIL
       | table_constructor
       | anonymous_function
       | NAME
       | "(" expr ")"

anonymous_function: "function" "(" [param_list] ")" block "end"

table_constructor: "{" [table_fields] "}"

table_fields: table_field ("," table_field)* [","]

table_field: "[" expr "]" "=" expr
           | NAME "=" expr
           | expr

HEX_DECIMAL: /0x[0-9a-fA-F]*\.[0-9a-fA-F]+/
BINARY_DECIMAL: /0b[01]+\.[01]+/
HEX_NUMBER: /0x[0-9a-fA-F]+/
BINARY_NUMBER: /0b[01]+/
DECIMAL_NUMBER: /\d+\.\d+/ | /\.\d+/ | /\d+/

NUMBER: HEX_DECIMAL | BINARY_DECIMAL | HEX_NUMBER | BINARY_NUMBER | DECIMAL_NUMBER

STRING: /"[^"]*"/ | /'[^']*'/

BOOLEAN: "true" | "false"

NIL: "nil"

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /--[^\n]*/
C_COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
%ignore C_COMMENT
