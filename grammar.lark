start: statement*

block: statement*

?statement: function_def [";"]
          | local_decl [";"]
          | if_stmt [";"]
          | for_stmt [";"]
          | while_stmt [";"]
          | return_stmt [";"]
          | break_stmt [";"]
          | assignment [";"]
          | expr_stmt [";"]

break_stmt: BREAK

function_def: FUNCTION function_name "(" [param_list] ")" block END
            | FUNCTION function_name ":" any_name "(" [param_list] ")" block END

function_name: any_name ("." any_name)*

param_list: NAME ("," NAME)*

local_decl: LOCAL NAME ("," NAME)* ["=" expr_list]

if_stmt: IF expr THEN block elif_parts else_part END
       | IF "(" expr ")" statement [ELSE statement+]

elif_parts: (ELSEIF expr THEN block)*

else_part: [ELSE block]

for_stmt: FOR NAME "=" expr "," expr ["," expr] DO block END
        | FOR NAME ("," NAME)* IN expr DO block END

while_stmt: WHILE expr DO block END
          | WHILE "(" expr ")" statement

return_stmt: RETURN [expr_list]

?expr_stmt: atom

assignment: assignable_list "=" expr_list
          | assignable COMPOUND_OP expr

assignable_list: assignable ("," assignable)*

assignable: NAME table_suffix*
          | primary function_call+ table_suffix+

expr_list: expr ("," expr)*

?expr: or_expr

?or_expr: and_expr (OR and_expr)*

?and_expr: not_expr (AND not_expr)*

?not_expr: NOT not_expr
         | comparison

?comparison: concat (COMP_OP concat)*

COMP_OP: "==" | "~=" | "!=" | "<=" | ">=" | "<" | ">"

COMPOUND_OP: "+=" | "-=" | "*=" | "/=" | "%="

PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
PERCENT: "%"
BACKSLASH: "\\"
HASH: "#"
CONCAT: ".."

?concat: add_expr (CONCAT add_expr)*

?add_expr: mult_expr ((PLUS | MINUS) mult_expr)*

?mult_expr: unary ((STAR | SLASH | PERCENT | BACKSLASH) unary)*

unary: MINUS unary
     | HASH unary
     | atom

?atom: primary suffix*

?suffix: table_suffix
       | function_call

table_suffix: "." any_name
            | "[" expr "]"

function_call: "(" [expr_list] ")"
             | ":" any_name "(" [expr_list] ")"

primary: NUMBER
       | STRING
       | BOOLEAN
       | NIL
       | table_constructor
       | anonymous_function
       | NAME
       | "(" expr ")"

anonymous_function: FUNCTION "(" [param_list] ")" block END

table_constructor: "{" [table_fields] "}"

table_fields: table_field ("," table_field)* [","]

table_field: "[" expr "]" "=" expr
           | any_name "=" expr
           | expr

HEX_DECIMAL: /0x[0-9a-fA-F]*\.[0-9a-fA-F]+/
BINARY_DECIMAL: /0b[01]+\.[01]+/
HEX_NUMBER: /0x[0-9a-fA-F]+/
BINARY_NUMBER: /0b[01]+/
DECIMAL_NUMBER: /\d+\.\d+/ | /\.\d+/ | /\d+/

NUMBER: HEX_DECIMAL | BINARY_DECIMAL | HEX_NUMBER | BINARY_NUMBER | DECIMAL_NUMBER

STRING: /"[^"]*"/ | /'[^']*'/

// Keywords (defined before NAME to take priority in basic lexer)
FUNCTION: "function"
LOCAL: "local"
IF: "if"
THEN: "then"
ELSEIF: "elseif"
ELSE: "else"
END: "end"
DO: "do"
WHILE: "while"
FOR: "for"
IN: "in"
RETURN: "return"
AND: "and"
OR: "or"
NOT: "not"
BREAK: "break"
BOOLEAN.2: "true" | "false"
NIL.2: "nil"

// any_name allows keywords to be used as identifiers in specific contexts
?any_name: NAME | keyword
?keyword: FUNCTION | LOCAL | IF | THEN | ELSEIF | ELSE | END | DO | WHILE | FOR | IN | RETURN | AND | OR | NOT | BREAK

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /--[^\n]*/
C_COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
%ignore C_COMMENT